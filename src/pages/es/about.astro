---
import Base from "../../layouts/Base.astro";
import Header from "../../components/editorial/Header.astro";
import Footer from "../../components/editorial/Footer.astro";
import ContactCta from "../../components/editorial/sections/ContactCta.astro";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import Icon from "../../components/Icon.astro";
import { about, ui } from "../../data/content.ts";
import { getLang, localizePath } from "../../data/i18n.ts";

const lang = getLang(Astro.url.pathname);
const a = about[lang];
const t = ui[lang];
const SITE = "https://morysautoparts.com";
const aboutPath = localizePath("/about", lang);
const homePath = localizePath("/", lang);

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t.navHome, item: `${SITE}${homePath}` },
    { "@type": "ListItem", position: 2, name: a.breadcrumbAbout, item: `${SITE}${aboutPath}` },
  ],
};
---

<Base title={a.metaTitle} description={a.metaDescription} jsonLd={breadcrumb}>
  <Header />
  <main class="flex-1">
    <!-- Hero -->
    <section class="bg-brand-cream border-b border-brand-navy/15">
      <div class="mx-auto max-w-6xl px-5 lg:px-8 py-14 lg:py-20">
        <nav class="text-[0.7rem] uppercase tracking-[0.18em] text-brand-navy/55 mb-8" aria-label="Breadcrumb">
          <a href={homePath} class="hover:text-brand-yellow">{t.navHome}</a>
          <span class="mx-2">/</span>
          <span class="text-brand-navy">{a.breadcrumbAbout}</span>
        </nav>

        <div class="grid lg:grid-cols-12 gap-8 lg:items-end" data-reveal>
          <div class="lg:col-span-8">
            <p class="text-[0.7rem] font-bold uppercase tracking-[0.32em] text-brand-navy/70 border-l-4 border-brand-yellow pl-3">
              {a.eyebrowShop}
            </p>
            <h1 class="mt-5 font-condensed font-bold uppercase text-5xl sm:text-6xl lg:text-7xl leading-[0.9] text-brand-navy">
              {a.h1Lead}<br />
              <span class="relative inline-block">
                <span class="relative z-10">{a.h1Highlight}</span>
                <span class="absolute left-0 right-0 -bottom-1 h-3 lg:h-4 bg-brand-yellow -z-0" aria-hidden="true"></span>
              </span>.
            </h1>
          </div>
          <div class="lg:col-span-4">
            <p class="text-base text-brand-ink/85 font-serif leading-relaxed border-l-2 border-brand-navy/20 pl-5">
              {a.heroBlurb}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Story -->
    <section class="bg-white border-b border-brand-navy/15 py-16 lg:py-24">
      <div class="mx-auto max-w-6xl px-5 lg:px-8 grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        <div class="lg:col-span-7" data-reveal>
          <h2 class="font-condensed font-bold uppercase text-3xl sm:text-4xl text-brand-navy leading-[0.95]">
            {a.storyHeading}
          </h2>
          <div class="mt-6 space-y-5 text-lg text-brand-ink/85 font-serif leading-relaxed">
            {a.storyParagraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <div class="lg:col-span-5" data-reveal data-reveal-delay="100">
          <div class="relative">
            <PhotoPlaceholder
              label={a.storyPhotoLabel}
              ratio="4/5"
              recommended="1200×1500 JPG"
              class="!rounded-none ring-1 ring-brand-navy/10"
            />
            <div class="absolute -bottom-4 -left-4 bg-brand-yellow text-brand-navy px-4 py-3 max-w-[15rem]">
              <p class="text-[0.6rem] uppercase tracking-[0.2em] font-bold">{a.ownerCaptionLabel}</p>
              <p class="mt-1 font-condensed text-lg font-bold uppercase leading-tight">{a.ownerCaptionName}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats band -->
    <section class="bg-brand-navy text-white border-b border-brand-navy/15">
      <div class="mx-auto max-w-6xl px-5 lg:px-8 grid grid-cols-2 lg:grid-cols-4" data-reveal>
        {a.stats.map((s, i) => (
          <div class={`py-8 lg:py-10 px-3 lg:px-6 ${i % 2 === 1 ? "border-l border-white/15" : ""} ${i > 1 ? "border-t lg:border-t-0" : ""} ${i > 0 ? "lg:border-l border-white/15" : ""}`}>
            <p class="font-condensed font-bold uppercase text-4xl lg:text-5xl text-brand-yellow leading-none">{s.value}</p>
            <p class="mt-2 text-[0.65rem] uppercase tracking-[0.18em] text-white/60 font-semibold">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Values -->
    <section class="bg-brand-cream border-b border-brand-navy/15 py-16 lg:py-24">
      <div class="mx-auto max-w-6xl px-5 lg:px-8" data-reveal>
        <p class="text-[0.7rem] font-bold uppercase tracking-[0.32em] text-brand-navy/70 border-l-4 border-brand-yellow pl-3">
          {a.eyebrowValues}
        </p>
        <div class="mt-10 grid gap-px bg-brand-navy/15 sm:grid-cols-3 border border-brand-navy/20">
          {a.values.map((v) => (
            <div class="bg-brand-cream p-7 lg:p-8">
              <div class="w-12 h-12 bg-brand-yellow text-brand-navy flex items-center justify-center mb-5">
                <Icon name={v.icon} size={24} strokeWidth={1.75} />
              </div>
              <h3 class="font-condensed font-bold uppercase text-2xl text-brand-navy tracking-[0.01em] leading-tight">{v.title}</h3>
              <p class="mt-3 text-brand-ink/80 font-serif leading-relaxed">{v.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ContactCta />
  </main>
  <Footer />
</Base>
