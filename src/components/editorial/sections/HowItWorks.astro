---
import Icon from "../../Icon.astro";
import { howItWorks, sections } from "../../../data/content.ts";
import { getLang } from "../../../data/i18n.ts";

const lang = getLang(Astro.url.pathname);
const s = sections[lang];
const steps = howItWorks[lang];
---

<section class="bg-white py-20 lg:py-28 border-b border-brand-navy/15">
  <div class="mx-auto max-w-6xl px-5 lg:px-8" data-reveal>
    <div class="grid lg:grid-cols-12 gap-8 lg:items-end">
      <div class="lg:col-span-7">
        <p class="text-[0.7rem] font-bold uppercase tracking-[0.32em] text-brand-navy/70 border-l-4 border-brand-yellow pl-3">
          {s.howEyebrow}
        </p>
        <h2 class="mt-5 font-condensed font-bold uppercase text-5xl sm:text-6xl lg:text-7xl leading-[0.9] text-brand-navy">
          {s.howHeadingLine1}<br />{s.howHeadingLine2}
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-base text-brand-ink/85 font-serif leading-relaxed border-l-2 border-brand-navy/20 pl-5">
          {s.howBlurb}
        </p>
      </div>
    </div>

    <ol class="mt-14 divide-y divide-brand-navy/15 border-y border-brand-navy/20">
      {steps.map((step) => (
        <li class="grid lg:grid-cols-12 gap-6 py-8 lg:py-10 items-start">
          <div class="lg:col-span-2">
            <span class="font-condensed font-bold text-7xl lg:text-8xl text-brand-yellow leading-none">{step.n}</span>
          </div>
          <div class="lg:col-span-1 hidden lg:flex justify-center pt-3">
            <Icon name={step.icon} size={32} strokeWidth={1.5} class="text-brand-navy/70" />
          </div>
          <div class="lg:col-span-5">
            <h3 class="font-condensed font-bold uppercase text-2xl lg:text-3xl text-brand-navy tracking-[0.01em] leading-tight">
              {step.title}
            </h3>
          </div>
          <div class="lg:col-span-4">
            <p class="text-base text-brand-ink/85 font-serif leading-relaxed">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
